# Kivo Workspace Git Ignore Rules

# Tunnel and execution binaries — NEVER commit large binaries
cloudflared
cloudflared.exe
ngrok
ngrok.exe

# Python Virtual Environment & Caches
backend/venv/
backend/.venv/
**/venv/
**/.venv/
backend/__pycache__/
backend/app/__pycache__/
backend/app/api/__pycache__/
backend/app/api/routes/__pycache__/
backend/app/core/__pycache__/
backend/app/core/processors/__pycache__/
backend/app/models/__pycache__/
*.pyc
**/__pycache__/
backend/.pytest_cache/
.pytest_cache/
*.egg-info/

# Local Storage, Databases & Model Weights
backend/storage/
storage/
*.db
*.sqlite
*.sqlite3
*.usearch
*.faiss
*.npy
*.onnx
backend/.requirements_hash
frontend/.flutter_build_hash

# Environment files — NEVER commit secrets
.env
.env.*
*.env

# Build artifacts
frontend/build/
!frontend/build/web/
dist/
build/
*.spec.bak
backend/dist/
backend/build/

# Internal documentation folder
docs/hidden/

# IDEs and OS files
.DS_Store
**/.DS_Store
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Logs and temp files
logs/
*.log
tmp/
backend/scratch/
backend/uvicorn.log
problem.txt
problem*.txt

# Others folder
others/

# Local build artifacts
*.dmg
AppIcon.icns
backend/*.spec
